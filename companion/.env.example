# Local development environment for the companion service (used with: npm run dev)
COMPANION_DEBUG=true
GAME_ROOT=./tmp-gameroot

PANEL_ENABLED=true
PANEL_PORT=8213
PANEL_USERNAME=admin
PANEL_PASSWORD=local-dev-password
PANEL_DEFAULT_LANGUAGE=en

DISCORD_STATUS_ENABLED=false
DISCORD_STATUS_WEBHOOK_URL=
DISCORD_STATUS_UPDATE_INTERVAL=30

# Point at `npm run mock` (dev/mock-palserver.ts) or a real container's published 8212
RESTAPI_ENABLED=true
RESTAPI_PORT=8212
RESTAPI_TIMEOUT=10
ADMIN_PASSWORD=local-dev-admin
